       With[{BrauerAlgebra`Private`convention = Apply[Sequence, 
            
            OptionValue[{BrauerAlgebra`BrauerProduct}, {
             BrauerAlgebra`Private`options}, {
             BrauerAlgebra`ProductConvention}]]}, 
         If[BrauerAlgebra`Private`convention === Below, 
          PermutationProduct[
          BrauerAlgebra`Private`perm2, BrauerAlgebra`Private`perm1], 
          PermutationProduct[
          BrauerAlgebra`Private`perm1, BrauerAlgebra`Private`perm2]]], 
       BrauerAlgebra`BrauerProduct[{
          Pattern[BrauerAlgebra`Private`\[Delta], 
