            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"ConjugacyClass[d] returns the list of the elements \
which are \\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)-conjugate to d in \\!\\(\
\\*SubscriptBox[\\(B\\), \\(n\\)]\\)(\\!\\(\\*SubscriptBox[\\(\[Delta]\\), \
\\(b\\)]\\)). \\nConjugacyClass[bracelets] returns the conjugacy class \
associated with the Bracelets bracelets.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"ConjugacyClass", "[", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`blist_BrauerList", ",", 
                    "BrauerAlgebra`Private`n_"}], "]"}], ":=", 
                    RowBox[{"Block", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"BrauerAlgebra`Private`range", "=", 
                    RowBox[{"Range", "[", "BrauerAlgebra`Private`n", "]"}]}], 
                    ",", "BrauerAlgebra`Private`grp"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"BrauerAlgebra`Private`grp", "=", 
                    RowBox[{"Cycles", "/@", 
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"Join", "[", 
                    RowBox[{"#1", ",", "#2"}], "]"}], ",", "1"}], "]"}], 
                    "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"List", "@@@", 
                    RowBox[{"PermutationCycles", "/@", 
                    
                    RowBox[{"Permutations", "[", 
                    "BrauerAlgebra`Private`range", "]"}]}]}], ",", 
                    RowBox[{"List", "@@@", 
                    RowBox[{"PermutationCycles", "/@", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Join", "[", 
                    RowBox[{"BrauerAlgebra`Private`range", ",", "#1"}], "]"}],
                     "&"}], ")"}], "/@", 
                    RowBox[{"Permutations", "[", 
                    RowBox[{"BrauerAlgebra`Private`range", "+", 
                    "BrauerAlgebra`Private`n"}], "]"}]}]}]}]}], "}"}]}], 
                    "]"}]}]}], ";", 
                    RowBox[{"BrauerList", "/@", 
                    RowBox[{"DeleteDuplicates", "[", 
                    RowBox[{"Map", "[", 
                    RowBox[{"Sort", ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Partition", "[", 
                    RowBox[{"#1", ",", "2"}], "]"}], "&"}], ")"}], "/@", 
                    RowBox[{"PermutationReplace", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "@@", "BrauerAlgebra`Private`blist"}], 
                    ",", "BrauerAlgebra`Private`grp"}], "]"}]}], ",", "2"}], 
                    "]"}], "]"}]}]}]}], "]"}]}]}, {" "}, {
                    RowBox[{
                    RowBox[{"ConjugacyClass", "[", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`blist_BrauerList", "?", 
                    "SymmetricGroupQ"}], "]"}], ":=", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`ConjugacyClassPerm", "[", 
                    "BrauerAlgebra`Private`blist", "]"}]}]}, {" "}, {
                    RowBox[{
                    
                    RowBox[{
                    "ConjugacyClass", "[", 
                    "BrauerAlgebra`Private`blist_BrauerList", "]"}], ":=", 
                    RowBox[{"ConjugacyClass", "[", 
                    RowBox[{"BrauerAlgebra`Private`blist", ",", 
                    RowBox[{"Length", "@@", "BrauerAlgebra`Private`blist"}]}],
                     "]"}]}]}, {" "}, {
                    RowBox[{
                    
                    RowBox[{
                    "ConjugacyClass", "[", 
                    "BrauerAlgebra`Private`brauertab_Bracelets", "]"}], ":=", 
                    
                    RowBox[{"ConjugacyClass", "[", 
                    
                    RowBox[{
                    "ToRepresentativeDiagram", "[", 
                    "BrauerAlgebra`Private`brauertab", "]"}], "]"}]}]}, {
                   " "}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
