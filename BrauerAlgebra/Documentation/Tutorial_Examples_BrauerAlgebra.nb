              Method -> "Preemptive", PassEventsDown -> Automatic, 
              PassEventsUp -> True}]],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], "\[SpanFromLeft]"}
        },
        AutoDelete->False,
        FrameStyle->Directive[
          LightDarkSwitched[
           GrayLevel[0.8]], 
          Thickness[Tiny]],
        GridBoxAlignment->{"Columns" -> {Left, Right}, "Rows" -> {{Center}}},
        GridBoxDividers->{
         "Columns" -> {{None}}, "Rows" -> {False, {True}, False}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
       "Grid"]}, Dynamic[System`InformationDump`open$$],
      BaselinePosition->Baseline,
      FrameMargins->0,
      ImageSize->Automatic],
     DynamicModuleValues:>{}],
    BaseStyle->"InformationGridFrame",
    StripOnInput->False], "InformationGridPlain",
   StripOnInput->False],
  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "(*********** Schur-Weyl duality not considered : \!\(\*SubscriptBox[\(\
\[Delta]\), \(b\)]\) is a parameter ************)\nTracelessProjector[n] \
returns the traceless projector in \!\(\*SubscriptBox[\(B\), \
\(n\)]\)(\!\(\*SubscriptBox[\(\[Delta]\), \(b\)]\)) in terms of conjugacy \
class sums. \nTracelessProjector[n,f] returns the f-traceless projector in \!\
\(\*SubscriptBox[\(B\), \(n\)]\)(\!\(\*SubscriptBox[\(\[Delta]\), \(b\)]\)) \
in terms of conjugacy class sums. \n(*********** Schur-Weyl duality may be \
considered : \!\(\*SubscriptBox[\(\[Delta]\), \(b\)]\) is an integer \
************)\nTracelessProjector[n,f,{\[Epsilon]N}] returns the f-traceless \
projector in \!\(\*SubscriptBox[\(B\), \(n\)]\)(\[Epsilon]N) where \
\[Epsilon]=\[PlusMinus]1 and N is positive \
integer.\!\(\*ButtonBox[StyleBox[\"[Bulgakova&Goncharov&Helpin 2022]\", \
\"SR\"],Active->True,BaseStyle->\"Link\",ButtonData->\"http://dx.doi.org/10.\
48550/arXiv.2212.14496\"]\) (* This function is still experimental for f>1 *)\
\n\n(********************************** Options \
*********************************)\nAn important option of this function for \
application to tensor calculus is SchurWeylDual. \nIt can take the value \
OrthogonalGroup, SymplecticGroup or None. This option is effective only when \
\[Epsilon]N appears in the input.", "Documentation" -> None, "OwnValues" -> 
    None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, BrauerAlgebra`TracelessProjector, {
      BrauerAlgebra`TracelessProjector[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], {
          Alternatives[
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Symbol]], 
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Integer]], 
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Plus]], 
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Times]]]}, 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`Private`TracelessProjector0[
        BrauerAlgebra`Private`n, BrauerAlgebra`Private`\[Delta], 
         BrauerAlgebra`Private`options], BrauerAlgebra`TracelessProjector[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`TracelessProjector[BrauerAlgebra`Private`n, {
          BrauerAlgebra`BrauerParameter[]}, BrauerAlgebra`Private`options], 
       BrauerAlgebra`TracelessProjector[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 1, {
          Alternatives[
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Symbol]], 
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Integer]], 
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Plus]], 
           Pattern[BrauerAlgebra`Private`\[Delta], 
            Blank[Times]]]}, 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`TracelessProjector[
        BrauerAlgebra`Private`n, {BrauerAlgebra`Private`\[Delta]}, 
         BrauerAlgebra`Private`options], BrauerAlgebra`TracelessProjector[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 1, 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`TracelessProjector[
        BrauerAlgebra`Private`n, BrauerAlgebra`Private`options], Condition[
         BrauerAlgebra`TracelessProjector[
          Pattern[BrauerAlgebra`Private`n, 
           Blank[]], 
          Pattern[BrauerAlgebra`Private`f, 
           Blank[Integer]], 
          Pattern[BrauerAlgebra`Private`options, 
           OptionsPattern[]]], BrauerAlgebra`Private`f > 1] :> 
       BrauerAlgebra`CentralIdempotent[
        BrauerAlgebra`Private`n, BrauerAlgebra`Private`f - 1], Condition[
         BrauerAlgebra`TracelessProjector[
          Pattern[BrauerAlgebra`Private`n, 
           Blank[]], 
          Pattern[BrauerAlgebra`Private`f, 
           Blank[Integer]], {
           Alternatives[
            Pattern[BrauerAlgebra`Private`dim, 
             Blank[Symbol]], 
            Pattern[BrauerAlgebra`Private`dim, 
             Blank[Integer]], 
            Pattern[BrauerAlgebra`Private`dim, 
             Blank[Plus]]]}, 
          Pattern[BrauerAlgebra`Private`options, 
           OptionsPattern[]]], BrauerAlgebra`Private`f > 1] :> ReplaceAll[
         BrauerAlgebra`CentralIdempotent[
         BrauerAlgebra`Private`n, BrauerAlgebra`Private`f - 1], 
         BrauerAlgebra`BrauerParameter[] -> BrauerAlgebra`Private`dim]}], 
    "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
    "FormatValues" -> None, 
    "Options" -> {
     BrauerAlgebra`SchurWeylDual -> SymmetricFunctions`OrthogonalGroup}, 
    "Attributes" -> {Protected}, "FullName" -> 
    "BrauerAlgebra`TracelessProjector"|>, False]]], "Output",
 CellChangeTimes->{
  3.876051002206153*^9, 3.8760547869323587`*^9, 3.876059647939937*^9, 
