          BrauerAlgebra`BrauerParameter[]}, BrauerAlgebra`Private`arg1, 
         BrauerAlgebra`Private`args, BrauerAlgebra`Private`options], 
       BrauerAlgebra`BrauerProduct[{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}, 
         Pattern[BrauerAlgebra`Private`exp, 
          Blank[]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> BrauerAlgebra`Private`exp, 
       BrauerAlgebra`BrauerProduct[
