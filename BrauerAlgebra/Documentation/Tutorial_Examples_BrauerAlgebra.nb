                 BrauerAlgebra`Private`list1, BrauerAlgebra`Private`arcs1], {
                 2}], 
                SymmetricFunctions`mycomplementSmall[
                BrauerAlgebra`Private`list2, BrauerAlgebra`Private`arcs2]], 
               BrauerAlgebra`Private`rulesbrauerproduct]], 
           BrauerAlgebra`Private`arcs1 = 
            Select[BrauerAlgebra`Private`list1, 
              BrauerAlgebra`Private`ArcUpQ[#]& ]; 
           BrauerAlgebra`Private`arcs2 = 
            Select[BrauerAlgebra`Private`list2, 
              BrauerAlgebra`Private`ArcDownQ[#]& ]; 
           BrauerAlgebra`Private`proddiag0 = ReleaseHold[
              ReplaceRepeated[
               Join[
                Map[BrauerAlgebra`DownInteger, 
                 SymmetricFunctions`mycomplementSmall[
                 BrauerAlgebra`Private`list2, BrauerAlgebra`Private`arcs2], {
                 2}], 
                SymmetricFunctions`mycomplementSmall[
                BrauerAlgebra`Private`list1, BrauerAlgebra`Private`arcs1]], 
               BrauerAlgebra`Private`rulesbrauerproduct]]]; 
         BrauerAlgebra`Private`proddiag = 
          DeleteCases[BrauerAlgebra`Private`proddiag0, {
             Pattern[BrauerAlgebra`Private`a, 
              Blank[]], 
             Pattern[BrauerAlgebra`Private`a, 
              Blank[]]}]; 
         BrauerAlgebra`Private`nloops = 
          Length[BrauerAlgebra`Private`proddiag0] - Length[
           BrauerAlgebra`Private`proddiag]; 
         BrauerAlgebra`Private`proddiag = 
