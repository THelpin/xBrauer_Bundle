         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> BrauerAlgebra`Private`arg1, 
       BrauerAlgebra`BrauerProduct[{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}, 
         Pattern[BrauerAlgebra`Private`arg1, 
          Blank[BrauerAlgebra`BrauerList]], 
         Pattern[BrauerAlgebra`Private`arg2, 
          Blank[BrauerAlgebra`BrauerList]], 
         Pattern[BrauerAlgebra`Private`arg3, 
          BlankSequence[BrauerAlgebra`BrauerList]]] :> 
       BrauerAlgebra`BrauerProduct[{BrauerAlgebra`Private`\[Delta]}, 
         BrauerAlgebra`Private`arg1, 
         BrauerAlgebra`BrauerProduct[{BrauerAlgebra`Private`\[Delta]}, 
          BrauerAlgebra`Private`arg2, BrauerAlgebra`Private`arg3]], 
       Verbatim[BrauerAlgebra`BrauerProduct][{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}] :> BrauerAlgebra`GeneratorPerm[0], 
       Verbatim[BrauerAlgebra`BrauerProduct][{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}, 
         Pattern[BrauerAlgebra`Private`left, 
          BlankNullSequence[]], 
         BrauerAlgebra`GeneratorPerm[0], 
         Pattern[BrauerAlgebra`Private`right, 
          BlankNullSequence[]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`BrauerProduct[
        BrauerAlgebra`Private`left, BrauerAlgebra`Private`right, 
         BrauerAlgebra`Private`options], 
       Verbatim[BrauerAlgebra`BrauerProduct][{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}, 
         Pattern[BrauerAlgebra`Private`left, 
          BlankNullSequence[]], 
         Cycles[{}], 
         Pattern[BrauerAlgebra`Private`right, 
          BlankNullSequence[]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`BrauerProduct[
        BrauerAlgebra`Private`left, BrauerAlgebra`Private`right, 
         BrauerAlgebra`Private`options], BrauerAlgebra`BrauerProduct[{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}, 
         Pattern[BrauerAlgebra`Private`left, 
          BlankNullSequence[]], 0, 
         Pattern[BrauerAlgebra`Private`right, 
          BlankNullSequence[]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 0, BrauerAlgebra`BrauerProduct[{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}, 
         Pattern[BrauerAlgebra`Private`left, 
          BlankNullSequence[]], 
         Pattern[BrauerAlgebra`Private`sum, 
