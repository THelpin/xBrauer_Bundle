         Pattern[BrauerAlgebra`Private`perm1, 
          Blank[Cycles]], 
         Pattern[BrauerAlgebra`Private`x, 
          BrauerAlgebra`BrauerList[
           Pattern[BrauerAlgebra`Private`list, 
            Blank[]]]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       With[{BrauerAlgebra`Private`n = Length[BrauerAlgebra`Private`list]}, 
         BrauerAlgebra`BrauerProduct[{BrauerAlgebra`Private`\[Delta]}, 
          BrauerAlgebra`PermToBrauer[
          BrauerAlgebra`Private`perm1, BrauerAlgebra`Private`n], 
          BrauerAlgebra`Private`x, BrauerAlgebra`Private`options]], 
       BrauerAlgebra`BrauerProduct[{
          Pattern[BrauerAlgebra`Private`\[Delta], 
           Blank[]]}, 
         Pattern[BrauerAlgebra`Private`x, 
          BrauerAlgebra`BrauerList[
           Pattern[BrauerAlgebra`Private`list, 
