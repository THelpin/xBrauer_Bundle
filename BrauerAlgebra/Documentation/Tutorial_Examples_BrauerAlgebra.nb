         0, 0}, {0, 0}}, {{0, 2}}, {{1, 1}}, {{0, 0, 0, 0}}}, 
       BrauerAlgebra`BrauerCycles[1, 0] -> {{{1}}}, 
       BrauerAlgebra`BrauerCycles[2, 0] -> {{{2}}, {{1}, {1}}}, 
       BrauerAlgebra`BrauerCycles[2, 1] -> {{{0, 0}}}, 
       BrauerAlgebra`BrauerCycles[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[Integer]], 0] :> Map[Partition[#, 1]& , 
         IntegerPartitions[BrauerAlgebra`Private`n]], 
       BrauerAlgebra`BrauerCycles[
         PatternTest[
          Pattern[BrauerAlgebra`Private`n, 
           Blank[Integer]], # > 4& ]] :> (
        BrauerAlgebra`BrauerCycles[BrauerAlgebra`Private`n] = 
        Module[{BrauerAlgebra`Private`intpart2 = Rest[
             IntegerPartitions[BrauerAlgebra`Private`n, 2]], 
           BrauerAlgebra`Private`listbcycles}, 
          BrauerAlgebra`Private`listbcycles = 
           Map[If[Part[#, 1] < (2 BrauerAlgebra`Private`n)/3, {
               Join[{{{
                   Part[#, 1]}}}, 
                BrauerAlgebra`Private`CyclesListCanonical[
                 Part[#, 1]]], 
               Join[{{{
                   Part[#, 2]}}}, 
                BrauerAlgebra`Private`CyclesListCanonical[
                 Part[#, 2]]]}, 
              If[Part[#, 1] == BrauerAlgebra`Private`n - 1, {
                BrauerAlgebra`BrauerCycles[
                 Part[#, 1]], 
                BrauerAlgebra`BrauerCycles[
                 Part[#, 2]]}, {
                BrauerAlgebra`Private`SelectShapes[
                 BrauerAlgebra`BrauerCycles[
                  Part[#, 1]], 
                 IntegerPart[Part[#, 1]/2]], 
                Join[{{{
                    Part[#, 2]}}}, 
                 BrauerAlgebra`Private`CyclesListCanonical[
                  Part[#, 2]]]}]]& , BrauerAlgebra`Private`intpart2]; 
          DeleteDuplicates[
            Map[BrauerAlgebra`Private`SortCycles1, 
             Join[{{{BrauerAlgebra`Private`n}}}, 
              Flatten[
               Map[Flatten[
                 Outer[Join[#, #2, 1]& , 
                  Part[#, 1], 
                  Part[#, 2], 1], 1]& , BrauerAlgebra`Private`listbcycles], 
               1], 
              BrauerAlgebra`Private`CyclesListCanonical[
              BrauerAlgebra`Private`n]]]]]), BrauerAlgebra`BrauerCycles[
         Pattern[BrauerAlgebra`Private`nbrauer, 
          Blank[Integer]], 1] :> DeleteDuplicates[
         Map[BrauerAlgebra`Private`SortCycles1, 
          Join[
           Flatten[
            Map[Flatten[
              Outer[Join[#, #2, 1]& , 
               Split[
                BrauerAlgebra`Private`CyclesListCanonical[
                 Part[#, 1], 1]], 
               BrauerAlgebra`BrauerCycles[
                Part[#, 2], 0], 1], 1]& , 
             Flatten[
              Map[Permutations, 
               Rest[
                IntegerPartitions[BrauerAlgebra`Private`nbrauer, 2]]], 1]], 
            1], 
           Split[
            BrauerAlgebra`Private`CyclesListCanonical[
            BrauerAlgebra`Private`nbrauer, 1]]]]], 
       BrauerAlgebra`BrauerCycles[
         Pattern[BrauerAlgebra`Private`nbrauer, 
          Blank[Integer]], 
         Pattern[BrauerAlgebra`Private`narcs, 
          Blank[Integer]]] :> (
        BrauerAlgebra`BrauerCycles[
         BrauerAlgebra`Private`nbrauer, BrauerAlgebra`Private`narcs] = 
        Module[{BrauerAlgebra`Private`res, BrauerAlgebra`Private`listshapes}, 
          With[{BrauerAlgebra`Private`listIntPartnbrauer = Select[
               Rest[
                IntegerPartitions[BrauerAlgebra`Private`nbrauer, 2]], 
               Apply[Plus, {
                  IntegerPart[Part[#, 1]/2], 
                  IntegerPart[Part[#, 2]/2]}] >= 
               BrauerAlgebra`Private`narcs& ], 
             BrauerAlgebra`Private`listIntPartnarccs = Flatten[
               Map[Permutations, 
                BrauerAlgebra`Private`myIntegerPartition[
                2, BrauerAlgebra`Private`narcs]], 1]}, 
            If[
            BrauerAlgebra`Private`narcs > 
             IntegerPart[BrauerAlgebra`Private`nbrauer/2], 
             BrauerAlgebra`Private`res = Null, 
             BrauerAlgebra`Private`listshapes = DeleteCases[
                Flatten[
                 
                 Outer[{#, #2}& , BrauerAlgebra`Private`listIntPartnbrauer, 
                  BrauerAlgebra`Private`listIntPartnarccs, 1], 1], 
                Condition[{{
                   Pattern[BrauerAlgebra`Private`a0, 
                    Blank[]], 
                   Pattern[BrauerAlgebra`Private`a1, 
                    Blank[]]}, {
                   Pattern[BrauerAlgebra`Private`b0, 
                    Blank[]], 
                   Pattern[BrauerAlgebra`Private`b1, 
                    Blank[]]}}, 
                 Or[
                 BrauerAlgebra`Private`b0 > 
                  IntegerPart[BrauerAlgebra`Private`a0/2], 
                  BrauerAlgebra`Private`b1 > 
                  IntegerPart[BrauerAlgebra`Private`a1/2]]]]; 
             BrauerAlgebra`Private`res = Join[
                DeleteDuplicates[
                 Map[BrauerAlgebra`Private`SortCycles1, 
                  Flatten[
                   Map[Flatten[
                    Outer[Join[#, #2]& , 
                    Part[#, 1], 
                    Part[#, 2], 1], 1]& , 
                    Map[Thread[
                    BrauerAlgebra`BrauerCycles[
                    Part[#, 1], 
                    Part[#, 2]]]& , BrauerAlgebra`Private`listshapes]], 1]]], 
                
                Split[
                 BrauerAlgebra`Private`CyclesListCanonical[
                 BrauerAlgebra`Private`nbrauer, 
                  BrauerAlgebra`Private`narcs]]]]]; 
          Return[BrauerAlgebra`Private`res, Module]])}], "SubValues" -> None, 
