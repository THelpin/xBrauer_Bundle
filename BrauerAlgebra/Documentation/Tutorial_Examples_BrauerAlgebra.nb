       Module[{BrauerAlgebra`Private`range = 
          Range[BrauerAlgebra`Private`n - 1], BrauerAlgebra`Private`symgroupQ,
           BrauerAlgebra`Private`output}, {
           BrauerAlgebra`Private`symgroupQ, BrauerAlgebra`Private`output} = 
          OptionValue[{BrauerAlgebra`BrauerGenerators}, {
            BrauerAlgebra`Private`options}, {
            BrauerAlgebra`SymmetricGroupOnly, SymmetricFunctions`Output}]; 
         If[BrauerAlgebra`Private`output == Symbol, 
           If[BrauerAlgebra`Private`symgroupQ, 
            Return[
             Map[
             BrauerAlgebra`GeneratorPerm[#]& , BrauerAlgebra`Private`range], 
             Module], 
            Return[
             Join[
              Map[
              BrauerAlgebra`GeneratorPerm[#]& , BrauerAlgebra`Private`range], 
              
              Map[
              BrauerAlgebra`GeneratorTrace[#]& , 
               BrauerAlgebra`Private`range]], Module]]]; 
         If[BrauerAlgebra`Private`symgroupQ, 
           Map[
           BrauerAlgebra`Private`CycleI[#, BrauerAlgebra`Private`n]& , 
            BrauerAlgebra`Private`range], 
           Join[
            Map[
            BrauerAlgebra`Private`CycleI[#, BrauerAlgebra`Private`n]& , 
             BrauerAlgebra`Private`range], 
            Map[
            BrauerAlgebra`Private`TraceI[#, BrauerAlgebra`Private`n]& , 
             BrauerAlgebra`Private`range]]]]}], "SubValues" -> None, 
