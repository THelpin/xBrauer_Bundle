Cell[CellGroupData[{

Cell["\<\
III. Conjugation by symmetric group elements in the Brauer algebra\
\>", "Section",
 CellChangeTimes->{{3.8454422891365757`*^9, 3.845442304216761*^9}, {
  3.845443470208641*^9, 3.845443490850087*^9}, {3.8768153456492147`*^9, 
  3.876815360303602*^9}},
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"1f385d3f-7901-43f3-adf6-d2b92ee33b27"],

Cell[CellGroupData[{

Cell["1. Parametrization of the conjugacy classes : ", "Subsection",
 CellChangeTimes->{{3.845442411551764*^9, 3.845442438091661*^9}, {
  3.870160102301784*^9, 
  3.8701601065017014`*^9}},ExpressionUUID->"870652b2-7630-4d77-96ed-\
b808a3cbfbef"],

Cell["\<\
One of the purpose of this package is to construct traceless projectors for \
tensors. These objects are naturally expressed in terms of conjugacy classes \
of the Brauer algebra. \
\>", "Text",
 CellChangeTimes->{{3.8655023184618177`*^9, 3.865502387557454*^9}, {
  3.876815371586418*^9, 3.87681541811847*^9}, {3.876978693983913*^9, 
  3.876978694284296*^9}, {3.886240220590414*^9, 
  3.886240221475471*^9}},ExpressionUUID->"afe4a6af-b2a4-4a32-8719-\
b52723004e6d"],

Cell[CellGroupData[{

Cell[BoxData[
