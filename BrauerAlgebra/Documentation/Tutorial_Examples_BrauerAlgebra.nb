Cell[TextData[{
 "The algorithm for constructing the traceless projectors uses the \
eigenvalues of the elements ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "1"], TraditionalForm]],ExpressionUUID->
  "344ad1da-52e2-4134-bd5b-2ef1cacadfad"],
 ". To obtain these eigenvalues without having to inverse a big matrix one \
uses the Littlewood Richardson rule. "
}], "Text",
 CellChangeTimes->{{3.876820317232089*^9, 3.876820434378481*^9}, {
  3.876821709113263*^9, 
  3.8768217096377277`*^9}},ExpressionUUID->"1dfb2f24-9ff1-4305-81fe-\
09cb7448706e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "EigenvaluesA"}]], "Input",
 CellChangeTimes->{{3.8768204367858953`*^9, 3.8768204415980587`*^9}},
 CellLabel->
  "In[217]:=",ExpressionUUID->"6a52484d-8bde-4abd-a784-532173400c3d"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"(********** The eigenvalues of class \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) are essential in the \
construction of the traceless projectors/central idempotents. **********) \
\\n(**********                    They are computed using the \
Littewood-Richardson rule. See for example : \
\\!\\(\\*ButtonBox[StyleBox[\\\"[Nazarov 1996]\\\", \
\\\"SR\\\"],Active->True,BaseStyle->\\\"Link\\\",ButtonData->\\\"http://dx.\
doi.org/10.1006/jabr.1996.0195\\\"]\\)\\!\\(\\*ButtonBox[StyleBox[\\\"[Cox&&\
De Visscher&&Martin 2007]\\\", \\\"SR\\\"],Active->True,BaseStyle->\\\"Link\\\
\",ButtonData->\\\"http://dx.doi.org/10.48550/arXiv.math/0601387\\\"]\\)     \
**********) \\n(* Case 1 : the product parameter \[Delta] in the Brauer \
Algebra is symbolic *)\\nEigenvaluesA[\[Mu],\[Lambda],\[Delta]] where \[Mu]\
\[RightTee]n and \[Lambda]\[RightTee]n-2f returns the eigenvalue of \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) on a simple \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)-module \
\\!\\(\\*SuperscriptBox[\\(L\\), \\(\[Mu]\\)]\\) (appearing in the \
decomposition of a simple \\!\\(\\*SubscriptBox[\\(B\\), \
\\(n\\)]\\)(\[Delta])-module \\!\\(\\*SuperscriptBox[\\(M\\), \
\\(\[Lambda]\\)]\\) upon restriction to \\!\\(\\*SubscriptBox[\\(S\\), \
\\(n\\)]\\)).\\nEigenvaluesA[\[Mu],\[Delta]] returns the eigenvalues of \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) on a simple \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)-module \
\\!\\(\\*SuperscriptBox[\\(L\\), \\(\[Mu]\\)]\\) (appearing in the \
decomposition of the simple \\!\\(\\*SubscriptBox[\\(B\\), \\(n\\)]\\)(\
\[Delta]) module upon restriction to \\!\\(\\*SubscriptBox[\\(S\\), \
\\(n\\)]\\)). \\nEigenvaluesA[n,\[Delta]] returns the eigenvalues of \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) on all simple \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)-module \
\\!\\(\\*SuperscriptBox[\\(L\\), \\(\[Mu]\\)]\\) with \[Mu]\[RightTee]n \
(appearing in the decomposition of the simple \\!\\(\\*SubscriptBox[\\(B\\), \
\\(n\\)]\\)(\[Delta]) module upon restriction to \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)).\\nThe input \[Delta] is \
optional, the default value is BrauerParameter[].\\n(* Case 2 : the product \
parameter \[Delta] in the Brauer Algebra is an integer \
*)\\nEigenvaluesA[\[Mu],\[Lambda],\[Epsilon]N,option], EigenvaluesA[\[Mu],\
\[Epsilon]N,option], EigenvaluesA[n,\[Epsilon]N,option] returns the \
eigenvalues of class \\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) with \
further constraints depending on the integer \[Epsilon]N and on the \\nchoice \
for the value of the option SchurWeylDual. One can choose either \
SchurWeylDual->None, SchurWeylDual->OrthogonalGroup or \
SchurWeylDual->SymplecticGroup.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`mu_List", ",", 
                    "BrauerAlgebra`Private`lambda_List", ",", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`dim_Symbol", "|", 
                    "BrauerAlgebra`Private`dim_Plus", "|", 
                    "BrauerAlgebra`Private`dim_Times"}], ",", 
                    RowBox[{"BrauerAlgebra`Private`options", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"BrauerAlgebra`Private`f", "=", 
                    RowBox[{
                    FractionBox["1", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Plus", "@@", "BrauerAlgebra`Private`mu"}], "-", 
                    RowBox[{"Plus", "@@", "BrauerAlgebra`Private`lambda"}]}], 
                    ")"}]}]}], "}"}], ",", 
                    RowBox[{"Factor", "[", 
                    RowBox[{
                    RowBox[{"BrauerAlgebra`Private`f", " ", 
                    RowBox[{"(", 
                    RowBox[{"BrauerAlgebra`Private`dim", "-", "1"}], ")"}]}], 
                    "+", 
                    
                    RowBox[{"BrauerAlgebra`Private`IntegerPartitionsContent", 
                    "[", "BrauerAlgebra`Private`mu", "]"}], "-", 
                    
                    RowBox[{"BrauerAlgebra`Private`IntegerPartitionsContent", 
                    "[", "BrauerAlgebra`Private`lambda", "]"}]}], "]"}]}], 
                    "]"}]}]}, {" "}, {
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    RowBox[{"BrauerAlgebra`Private`mu_List", ",", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`dim_Symbol", "|", 
                    "BrauerAlgebra`Private`dim_Plus", "|", 
                    "BrauerAlgebra`Private`dim_Times"}], ",", 
                    RowBox[{"BrauerAlgebra`Private`options", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    
                    RowBox[{"BrauerAlgebra`Private`mu", ",", "#1", ",", 
                    "BrauerAlgebra`Private`dim"}], "]"}], "&"}], ")"}], "/@", 
                    
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"InverseLittlewoodRichardsonRule", "[", 
                    RowBox[{"BrauerAlgebra`Private`mu", ",", "#1"}], "]"}], 
                    "&"}], ")"}], "/@", 
                    
                    RowBox[{"BrauerAlgebra`Private`EvenPartitionIn", "[", 
                    "BrauerAlgebra`Private`mu", "]"}]}], ",", "1"}], 
                    "]"}]}]}]}, {" "}, {
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    RowBox[{"BrauerAlgebra`Private`n_", ",", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`dim_Symbol", "|", 
                    "BrauerAlgebra`Private`dim_Plus", "|", 
                    "BrauerAlgebra`Private`dim_Times"}], ",", 
                    RowBox[{"BrauerAlgebra`Private`options", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    RowBox[{"#1", ",", "BrauerAlgebra`Private`dim"}], "]"}], 
                    "&"}], ")"}], "/@", 
                    RowBox[{"Most", "[", 
                    
                    RowBox[{
                    "IntegerPartitions", "[", "BrauerAlgebra`Private`n", 
                    "]"}], "]"}]}]}]}, {" "}, {
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`mu_List", ",", 
                    "BrauerAlgebra`Private`lambda_List", ",", 
                    "BrauerAlgebra`Private`dim_Integer", ",", 
                    RowBox[{"BrauerAlgebra`Private`options", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"Block", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"BrauerAlgebra`Private`f", "=", 
                    RowBox[{
                    FractionBox["1", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Plus", "@@", "BrauerAlgebra`Private`mu"}], "-", 
                    RowBox[{"Plus", "@@", "BrauerAlgebra`Private`lambda"}]}], 
                    ")"}]}]}], ",", "BrauerAlgebra`Private`schurweyl"}], 
                    "}"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "BrauerAlgebra`Private`schurweyl", "}"}], 
                    "=", 
                    RowBox[{"OptionValue", "[", 
                    RowBox[{
                    RowBox[{"{", "EigenvaluesA", "}"}], ",", 
                    RowBox[{"{", "BrauerAlgebra`Private`options", "}"}], ",", 
                    
                    RowBox[{"{", "SchurWeylDual", "}"}]}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"BrauerAlgebra`Private`schurweyl", "===", 
                    "OrthogonalGroup"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    
                    RowBox[{"Positive", "[", "BrauerAlgebra`Private`dim", 
                    "]"}]}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"EigenvaluesA", "::", "dimension"}], 
                    "MessageName"], ",", "BrauerAlgebra`Private`dim", ",", 
                    "BrauerAlgebra`Private`schurweyl"}], "]"}], "]"}]}], 
                    "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"BrauerAlgebra`Private`RestrictionsO", "[", 
                    
                    RowBox[{"BrauerAlgebra`Private`mu", ",", 
                    "BrauerAlgebra`Private`lambda", ",", 
                    "BrauerAlgebra`Private`dim"}], "]"}]}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"EigenvaluesA", "::", "schurweyl12"}], 
                    "MessageName"], ",", "BrauerAlgebra`Private`mu", ",", 
                    "BrauerAlgebra`Private`lambda", ",", 
                    "BrauerAlgebra`Private`schurweyl"}], "]"}], "]"}]}], 
                    "]"}], ";"}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"BrauerAlgebra`Private`schurweyl", "===", 
                    "SymplecticGroup"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    
                    RowBox[{"EvenQ", "[", "BrauerAlgebra`Private`dim", 
                    "]"}]}], "||", 
                    
                    RowBox[{"Positive", "[", "BrauerAlgebra`Private`dim", 
                    "]"}]}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"EigenvaluesA", "::", "dimension"}], 
                    "MessageName"], ",", "BrauerAlgebra`Private`dim", ",", 
                    "BrauerAlgebra`Private`schurweyl"}], "]"}], "]"}]}], 
                    "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"BrauerAlgebra`Private`RestrictionsSp", "[", 
                    
                    RowBox[{"BrauerAlgebra`Private`mu", ",", 
                    "BrauerAlgebra`Private`lambda", ",", 
                    "BrauerAlgebra`Private`dim"}], "]"}]}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"EigenvaluesA", "::", "schurweyl12"}], 
                    "MessageName"], ",", "BrauerAlgebra`Private`mu", ",", 
                    "BrauerAlgebra`Private`lambda", ",", 
                    "BrauerAlgebra`Private`schurweyl"}], "]"}], "]"}]}], 
                    "]"}], ";"}]}], "]"}], ";", 
                    RowBox[{"Factor", "[", 
                    RowBox[{
                    RowBox[{"BrauerAlgebra`Private`f", " ", 
                    RowBox[{"(", 
                    RowBox[{"BrauerAlgebra`Private`dim", "-", "1"}], ")"}]}], 
                    "+", 
                    
                    RowBox[{"BrauerAlgebra`Private`IntegerPartitionsContent", 
                    "[", "BrauerAlgebra`Private`mu", "]"}], "-", 
                    
                    RowBox[{"BrauerAlgebra`Private`IntegerPartitionsContent", 
                    "[", "BrauerAlgebra`Private`lambda", "]"}]}], "]"}]}]}], 
                    "]"}]}]}, {" "}, {
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    
                    RowBox[{
                    "BrauerAlgebra`Private`mu_List", ",", 
                    "BrauerAlgebra`Private`dim_Integer", ",", 
                    RowBox[{"BrauerAlgebra`Private`options", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"Block", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"BrauerAlgebra`Private`schurweyl", ",", 
                    "BrauerAlgebra`Private`res"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", "BrauerAlgebra`Private`schurweyl", "}"}], 
                    "=", 
                    RowBox[{"OptionValue", "[", 
                    RowBox[{
                    RowBox[{"{", "EigenvaluesA", "}"}], ",", 
                    RowBox[{"{", "BrauerAlgebra`Private`options", "}"}], ",", 
                    
                    RowBox[{"{", "SchurWeylDual", "}"}]}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"BrauerAlgebra`Private`schurweyl", "===", 
                    "OrthogonalGroup"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    
                    RowBox[{"Positive", "[", "BrauerAlgebra`Private`dim", 
                    "]"}]}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"EigenvaluesA", "::", "dimension"}], 
                    "MessageName"], ",", "BrauerAlgebra`Private`dim", ",", 
                    "BrauerAlgebra`Private`schurweyl"}], "]"}], "]"}]}], 
                    "]"}], ";", 
                    RowBox[{"BrauerAlgebra`Private`res", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"EigenvaluesA", "[", 
                    
                    RowBox[{"BrauerAlgebra`Private`mu", ",", "#1", ",", 
                    "BrauerAlgebra`Private`dim", ",", 
                    "BrauerAlgebra`Private`options"}], "]"}], "&"}], ")"}], 
                    "/@", 
                    RowBox[{"Select", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
