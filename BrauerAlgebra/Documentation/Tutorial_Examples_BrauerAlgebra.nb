   "ObjectType" -> "Symbol", "Usage" -> 
    "AClass[n,f] returns the Bracelets associated to the conjugacy class of \
flip invariant f-arcs diagrams with vertical lines.\nThe construction of the \
traceless projector relies heavily on AClass[n,1] and the space of traceless \
tensor of order n is annihilated by AClass[n,1]. See Lemma 3.1 \
\!\(\*ButtonBox[StyleBox[\"[Bulgakova&Goncharov&Helpin 2022]\", \
\"SR\"],Active->True,BaseStyle->\"Link\",ButtonData->\"http://dx.doi.org/10.\
48550/arXiv.2212.14496\"]\).", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, BrauerAlgebra`AClass, {BrauerAlgebra`AClass[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 0] :> BrauerAlgebra`IdClass[BrauerAlgebra`Private`n], 
       BrauerAlgebra`AClass[0, 
         Pattern[BrauerAlgebra`Private`f, 
          Blank[]]] :> {}, BrauerAlgebra`AClass[1, 
         Pattern[BrauerAlgebra`Private`ntraces, 
          Blank[]]] :> 0, BrauerAlgebra`AClass[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 
         Pattern[BrauerAlgebra`Private`f, 
          Blank[]]] :> BrauerAlgebra`Bracelets[
         Join[
          ConstantArray[{1, 2}, BrauerAlgebra`Private`f], 
          
          ConstantArray[{3}, BrauerAlgebra`Private`n - 2 
           BrauerAlgebra`Private`f]]]}], "SubValues" -> None, "DefaultValues" -> 
    None, "NValues" -> None, "FormatValues" -> None, "Options" -> None, 
    "Attributes" -> {Protected}, "FullName" -> "BrauerAlgebra`AClass"|>, 
   False]]], "Output",
