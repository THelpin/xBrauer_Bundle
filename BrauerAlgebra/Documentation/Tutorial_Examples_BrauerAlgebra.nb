     DownValues, BrauerAlgebra`CentralYoungProjector, {
      BrauerAlgebra`CentralYoungProjector[
         Pattern[BrauerAlgebra`Private`bracelets, 
          Blank[BrauerAlgebra`Bracelets]]] :> 
       BrauerAlgebra`CentralYoungProjector[
         BrauerAlgebra`Private`BraceletsToPartition[
         BrauerAlgebra`Private`bracelets]], 
       BrauerAlgebra`CentralYoungProjector[
         Pattern[BrauerAlgebra`Private`list, 
