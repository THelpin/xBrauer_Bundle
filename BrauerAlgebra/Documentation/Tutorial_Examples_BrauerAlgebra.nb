Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"LittlewoodRichardsonRule[\[Mu],\[Lambda]] returns a \
list of the partitions (with multiplicities)\\n corresponding to irreducible \
representations of GL appearing in the tensor product of the irreducible \
representations \[Mu] and \[Lambda].\\!\\(\\*ButtonBox[StyleBox[\\\"[Fulton \
1996]\\\", \
\\\"SR\\\"],Active->True,BaseStyle->\\\"Link\\\",ButtonData->\\\"http://dx.\
doi.org/10.1017/CBO9780511626241\\\"]\\)\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"LittlewoodRichardsonRule", "[", 
                    RowBox[{
                    RowBox[{"{", "}"}], ",", 
                    "SymmetricFunctions`Private`\[Lambda]_"}], "]"}], ":=", 
                    
                    RowBox[{
                    "{", "SymmetricFunctions`Private`\[Lambda]", "}"}]}]}, {
                   " "}, {
                    RowBox[{
                    RowBox[{"LittlewoodRichardsonRule", "[", 
                    RowBox[{"SymmetricFunctions`Private`\[Lambda]_", ",", 
                    RowBox[{"{", "}"}]}], "]"}], ":=", 
                    
                    RowBox[{
                    "{", "SymmetricFunctions`Private`\[Lambda]", "}"}]}]}, {
                   " "}, {
                    RowBox[{
                    RowBox[{
                    RowBox[{"LittlewoodRichardsonRule", "[", 
                    
                    RowBox[{
                    "SymmetricFunctions`Private`list1_", ",", 
                    "SymmetricFunctions`Private`list2_"}], "]"}], "/;", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"SymmetricFunctions`Private`list1", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                    "\[Equal]", "1"}], "||", 
                    RowBox[{
                    
                    RowBox[{"Length", "[", "SymmetricFunctions`Private`list1",
                     "]"}], "\[Equal]", "1"}]}]}], ":=", 
                    RowBox[{"SymmetricFunctions`Private`PieriRule", "[", 
                    
