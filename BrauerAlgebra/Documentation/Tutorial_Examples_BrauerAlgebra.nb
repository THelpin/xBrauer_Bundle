Cell[CellGroupData[{

Cell["3. Product in the Brauer algebra. ", "Subsection",
 CellChangeTimes->{{3.845438573867153*^9, 3.8454385939876747`*^9}, {
  3.845457144388527*^9, 3.845457144658646*^9}, {3.8769737237405977`*^9, 
