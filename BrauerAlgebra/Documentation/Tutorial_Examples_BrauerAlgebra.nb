Cell[TextData[{
 "The basis of the Brauer algebra ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["B", "n"], 
   RowBox[{"(", 
    SubscriptBox["\[Delta]", "b"], ")"}]}]],ExpressionUUID->
  "7ee7de6c-664e-40d3-bea8-ae4751f489b2"],
 " are perfect matchings among  2n elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "...", ",", " ", "n"}], "}"}], " ", "U", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      UnderscriptBox["1", "_"], ",", "...", ",", 
      UnderscriptBox["2", "_"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "ec3ad4ef-14ce-4024-9d54-ec2ebd23fe41"],
 " "
}], "Text",
