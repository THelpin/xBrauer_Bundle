\!\(\*SubscriptBox[\(B\), \(n\)]\)(\!\(\*SubscriptBox[\(\[Delta]\), \
\(b\)]\)). \nConjugacyClass[bracelets] returns the conjugacy class associated \
with the Bracelets bracelets.", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, BrauerAlgebra`ConjugacyClass, {BrauerAlgebra`ConjugacyClass[
         Pattern[BrauerAlgebra`Private`blist, 
          Blank[BrauerAlgebra`BrauerList]], 
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]]] :> 
       Block[{BrauerAlgebra`Private`range = Range[BrauerAlgebra`Private`n], 
          BrauerAlgebra`Private`grp}, 
         BrauerAlgebra`Private`grp = Map[Cycles, 
            MapThread[Flatten[
              Join[#, #2], 1]& , {
              MapApply[List, 
               Map[PermutationCycles, 
                Permutations[BrauerAlgebra`Private`range]]], 
              MapApply[List, 
               Map[PermutationCycles, 
                Map[Join[BrauerAlgebra`Private`range, #]& , 
                 Permutations[
                 BrauerAlgebra`Private`range + BrauerAlgebra`Private`n]]]]}]]; 
         Map[BrauerAlgebra`BrauerList, 
           DeleteDuplicates[
            Map[Sort, 
             Map[Partition[#, 2]& , 
              PermutationReplace[
               Apply[Flatten, BrauerAlgebra`Private`blist], 
               BrauerAlgebra`Private`grp]], 2]]]], 
       BrauerAlgebra`ConjugacyClass[
         PatternTest[
          Pattern[BrauerAlgebra`Private`blist, 
           Blank[BrauerAlgebra`BrauerList]], BrauerAlgebra`SymmetricGroupQ]] :> 
       BrauerAlgebra`Private`ConjugacyClassPerm[BrauerAlgebra`Private`blist], 
       BrauerAlgebra`ConjugacyClass[
         Pattern[BrauerAlgebra`Private`blist, 
          Blank[BrauerAlgebra`BrauerList]]] :> 
       BrauerAlgebra`ConjugacyClass[BrauerAlgebra`Private`blist, 
         Apply[Length, BrauerAlgebra`Private`blist]], 
       BrauerAlgebra`ConjugacyClass[
         Pattern[BrauerAlgebra`Private`brauertab, 
          Blank[BrauerAlgebra`Bracelets]]] :> BrauerAlgebra`ConjugacyClass[
         BrauerAlgebra`ToRepresentativeDiagram[
         BrauerAlgebra`Private`brauertab]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
