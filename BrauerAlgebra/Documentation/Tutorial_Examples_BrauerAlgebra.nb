            StyleBox["\<\"(********** The eigenvalues of class \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) are essential in the \
construction of the traceless projectors/central idempotents. **********) \
\\n(**********                    They are computed using the \
Littewood-Richardson rule. See for example : \
\\!\\(\\*ButtonBox[StyleBox[\\\"[Nazarov 1996]\\\", \
\\\"SR\\\"],Active->True,BaseStyle->\\\"Link\\\",ButtonData->\\\"http://dx.\
doi.org/10.1006/jabr.1996.0195\\\"]\\)\\!\\(\\*ButtonBox[StyleBox[\\\"[Cox&&\
De Visscher&&Martin 2007]\\\", \\\"SR\\\"],Active->True,BaseStyle->\\\"Link\\\
\",ButtonData->\\\"http://dx.doi.org/10.48550/arXiv.math/0601387\\\"]\\)     \
**********) \\n(* Case 1 : the product parameter \[Delta] in the Brauer \
Algebra is symbolic *)\\nEigenvaluesA[\[Mu],\[Lambda],\[Delta]] where \[Mu]\
\[RightTee]n and \[Lambda]\[RightTee]n-2f returns the eigenvalue of \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) on a simple \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)-module \
\\!\\(\\*SuperscriptBox[\\(L\\), \\(\[Mu]\\)]\\) (appearing in the \
decomposition of a simple \\!\\(\\*SubscriptBox[\\(B\\), \
\\(n\\)]\\)(\[Delta])-module \\!\\(\\*SuperscriptBox[\\(M\\), \
\\(\[Lambda]\\)]\\) upon restriction to \\!\\(\\*SubscriptBox[\\(S\\), \
\\(n\\)]\\)).\\nEigenvaluesA[\[Mu],\[Delta]] returns the eigenvalues of \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) on a simple \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)-module \
\\!\\(\\*SuperscriptBox[\\(L\\), \\(\[Mu]\\)]\\) (appearing in the \
decomposition of the simple \\!\\(\\*SubscriptBox[\\(B\\), \\(n\\)]\\)(\
\[Delta]) module upon restriction to \\!\\(\\*SubscriptBox[\\(S\\), \
\\(n\\)]\\)). \\nEigenvaluesA[n,\[Delta]] returns the eigenvalues of \
\\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) on all simple \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)-module \
\\!\\(\\*SuperscriptBox[\\(L\\), \\(\[Mu]\\)]\\) with \[Mu]\[RightTee]n \
(appearing in the decomposition of the simple \\!\\(\\*SubscriptBox[\\(B\\), \
\\(n\\)]\\)(\[Delta]) module upon restriction to \
\\!\\(\\*SubscriptBox[\\(S\\), \\(n\\)]\\)).\\nThe input \[Delta] is \
optional, the default value is BrauerParameter[].\\n(* Case 2 : the product \
parameter \[Delta] in the Brauer Algebra is an integer \
*)\\nEigenvaluesA[\[Mu],\[Lambda],\[Epsilon]N,option], EigenvaluesA[\[Mu],\
\[Epsilon]N,option], EigenvaluesA[n,\[Epsilon]N,option] returns the \
eigenvalues of class \\!\\(\\*SubscriptBox[\\(A\\), \\(n\\)]\\)(1) with \
further constraints depending on the integer \[Epsilon]N and on the \\nchoice \
for the value of the option SchurWeylDual. One can choose either \
SchurWeylDual->None, SchurWeylDual->OrthogonalGroup or \
SchurWeylDual->SymplecticGroup.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           TagBox[
            ButtonBox[
             PaneSelectorBox[{False->
              
              DynamicBox[FEPrivate`FrontEndResource[
               "FEBitmaps", "DownPointerOpener"],
               ImageSizeCache->{9., {2.3671875, 6.6328125}}], True->
              
              DynamicBox[FEPrivate`FrontEndResource[
               "FEBitmaps", "DownPointerOpenerHot"],
               ImageSizeCache->{9., {2.3671875, 6.6328125}}]}, Dynamic[
              System`InformationDump`mouseOver$$]],
             Alignment->Left,
             Appearance->{"Default" -> None},
             
             ButtonFunction:>FEPrivate`Set[
              System`InformationDump`open$$, True],
             Evaluator->Automatic,
             FrameMargins->{{9, 0}, {0, 0}},
             ImageMargins->0,
             ImageSize->Full,
             Method->"Preemptive"],
            
            EventHandlerTag[{
             "MouseEntered" :> 
              FEPrivate`Set[System`InformationDump`mouseOver$$, True], 
              "MouseExited" :> 
              FEPrivate`Set[System`InformationDump`mouseOver$$, False], 
              Method -> "Preemptive", PassEventsDown -> Automatic, 
              PassEventsUp -> True}]],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], "\[SpanFromLeft]"}
        },
        AutoDelete->False,
        FrameStyle->Directive[
          LightDarkSwitched[
           GrayLevel[0.8]], 
          Thickness[Tiny]],
        GridBoxAlignment->{"Columns" -> {Left, Right}, "Rows" -> {{Center}}},
        GridBoxDividers->{
         "Columns" -> {{None}}, "Rows" -> {False, {True}, False}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
       "Grid"]}, Dynamic[System`InformationDump`open$$],
      BaselinePosition->Baseline,
      FrameMargins->0,
      ImageSize->Automatic],
     DynamicModuleValues:>{}],
    BaseStyle->"InformationGridFrame",
    StripOnInput->False], "InformationGridPlain",
   StripOnInput->False],
  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "(********** The eigenvalues of class \!\(\*SubscriptBox[\(A\), \
\(n\)]\)(1) are essential in the construction of the traceless \
projectors/central idempotents. **********) \n(**********                    \
They are computed using the Littewood-Richardson rule. See for example : \!\(\
\*ButtonBox[StyleBox[\"[Nazarov 1996]\", \
\"SR\"],Active->True,BaseStyle->\"Link\",ButtonData->\"http://dx.doi.org/10.\
1006/jabr.1996.0195\"]\)\!\(\*ButtonBox[StyleBox[\"[Cox&&De Visscher&&Martin \
2007]\", \"SR\"],Active->True,BaseStyle->\"Link\",ButtonData->\"http://dx.doi.\
org/10.48550/arXiv.math/0601387\"]\)     **********) \n(* Case 1 : the \
product parameter \[Delta] in the Brauer Algebra is symbolic *)\n\
EigenvaluesA[\[Mu],\[Lambda],\[Delta]] where \[Mu]\[RightTee]n and \[Lambda]\
\[RightTee]n-2f returns the eigenvalue of \!\(\*SubscriptBox[\(A\), \
\(n\)]\)(1) on a simple \!\(\*SubscriptBox[\(S\), \(n\)]\)-module \
\!\(\*SuperscriptBox[\(L\), \(\[Mu]\)]\) (appearing in the decomposition of a \
simple \!\(\*SubscriptBox[\(B\), \(n\)]\)(\[Delta])-module \
\!\(\*SuperscriptBox[\(M\), \(\[Lambda]\)]\) upon restriction to \
\!\(\*SubscriptBox[\(S\), \(n\)]\)).\nEigenvaluesA[\[Mu],\[Delta]] returns \
the eigenvalues of \!\(\*SubscriptBox[\(A\), \(n\)]\)(1) on a simple \
\!\(\*SubscriptBox[\(S\), \(n\)]\)-module \!\(\*SuperscriptBox[\(L\), \(\[Mu]\
\)]\) (appearing in the decomposition of the simple \!\(\*SubscriptBox[\(B\), \
\(n\)]\)(\[Delta]) module upon restriction to \!\(\*SubscriptBox[\(S\), \
\(n\)]\)). \nEigenvaluesA[n,\[Delta]] returns the eigenvalues of \
\!\(\*SubscriptBox[\(A\), \(n\)]\)(1) on all simple \!\(\*SubscriptBox[\(S\), \
\(n\)]\)-module \!\(\*SuperscriptBox[\(L\), \(\[Mu]\)]\) with \
\[Mu]\[RightTee]n (appearing in the decomposition of the simple \
\!\(\*SubscriptBox[\(B\), \(n\)]\)(\[Delta]) module upon restriction to \
\!\(\*SubscriptBox[\(S\), \(n\)]\)).\nThe input \[Delta] is optional, the \
default value is BrauerParameter[].\n(* Case 2 : the product parameter \
\[Delta] in the Brauer Algebra is an integer *)\n\
EigenvaluesA[\[Mu],\[Lambda],\[Epsilon]N,option], EigenvaluesA[\[Mu],\
\[Epsilon]N,option], EigenvaluesA[n,\[Epsilon]N,option] returns the \
eigenvalues of class \!\(\*SubscriptBox[\(A\), \(n\)]\)(1) with further \
constraints depending on the integer \[Epsilon]N and on the \nchoice for the \
value of the option SchurWeylDual. One can choose either SchurWeylDual->None, \
SchurWeylDual->OrthogonalGroup or SchurWeylDual->SymplecticGroup.", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, BrauerAlgebra`EigenvaluesA, {BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`mu, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`lambda, 
          Blank[List]], 
         Alternatives[
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Symbol]], 
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Plus]], 
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Times]]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       With[{BrauerAlgebra`Private`f = (Apply[Plus, BrauerAlgebra`Private`mu] - 
            Apply[Plus, BrauerAlgebra`Private`lambda])/2}, 
         Factor[
         BrauerAlgebra`Private`f (BrauerAlgebra`Private`dim - 1) + 
          BrauerAlgebra`Private`IntegerPartitionsContent[
           BrauerAlgebra`Private`mu] - 
          BrauerAlgebra`Private`IntegerPartitionsContent[
          BrauerAlgebra`Private`lambda]]], BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`mu, 
          Blank[List]], 
         Alternatives[
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Symbol]], 
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Plus]], 
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Times]]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       Map[BrauerAlgebra`EigenvaluesA[
         BrauerAlgebra`Private`mu, #, BrauerAlgebra`Private`dim]& , 
         Flatten[
          Map[
          SymmetricFunctions`InverseLittlewoodRichardsonRule[
           BrauerAlgebra`Private`mu, #]& , 
           BrauerAlgebra`Private`EvenPartitionIn[BrauerAlgebra`Private`mu]], 
          1]], BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 
         Alternatives[
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Symbol]], 
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Plus]], 
          Pattern[BrauerAlgebra`Private`dim, 
           Blank[Times]]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       Map[BrauerAlgebra`EigenvaluesA[#, BrauerAlgebra`Private`dim]& , 
         Most[
          IntegerPartitions[BrauerAlgebra`Private`n]]], 
       BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`mu, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`lambda, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`dim, 
          Blank[Integer]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       Block[{BrauerAlgebra`Private`f = (
            Apply[Plus, BrauerAlgebra`Private`mu] - Apply[
            Plus, BrauerAlgebra`Private`lambda])/2, 
          BrauerAlgebra`Private`schurweyl}, {BrauerAlgebra`Private`schurweyl} = 
          OptionValue[{BrauerAlgebra`EigenvaluesA}, {
            BrauerAlgebra`Private`options}, {BrauerAlgebra`SchurWeylDual}]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`OrthogonalGroup, If[
             Not[
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           If[
             Not[
              BrauerAlgebra`Private`RestrictionsO[
              BrauerAlgebra`Private`mu, BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "schurweyl12"], 
               BrauerAlgebra`Private`mu, BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`schurweyl]]]; Null]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`SymplecticGroup, If[
             Or[
              Not[
               EvenQ[BrauerAlgebra`Private`dim]], 
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           If[
             Not[
              BrauerAlgebra`Private`RestrictionsSp[
              BrauerAlgebra`Private`mu, BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "schurweyl12"], 
               BrauerAlgebra`Private`mu, BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`schurweyl]]]; Null]; 
         Factor[BrauerAlgebra`Private`f (BrauerAlgebra`Private`dim - 1) + 
           BrauerAlgebra`Private`IntegerPartitionsContent[
            BrauerAlgebra`Private`mu] - 
           BrauerAlgebra`Private`IntegerPartitionsContent[
           BrauerAlgebra`Private`lambda]]], BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`mu, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`dim, 
          Blank[Integer]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       Block[{BrauerAlgebra`Private`schurweyl, 
          BrauerAlgebra`Private`res}, {BrauerAlgebra`Private`schurweyl} = 
          OptionValue[{BrauerAlgebra`EigenvaluesA}, {
            BrauerAlgebra`Private`options}, {BrauerAlgebra`SchurWeylDual}]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`OrthogonalGroup, If[
             Not[
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           BrauerAlgebra`Private`res = 
            Map[BrauerAlgebra`EigenvaluesA[
              BrauerAlgebra`Private`mu, #, BrauerAlgebra`Private`dim, 
               BrauerAlgebra`Private`options]& , 
              Select[
               Flatten[
                Map[
                SymmetricFunctions`InverseLittlewoodRichardsonRule[
                 BrauerAlgebra`Private`mu, #]& , 
                 BrauerAlgebra`Private`EvenPartitionIn[
                 BrauerAlgebra`Private`mu]], 1], 
               BrauerAlgebra`Private`BrauerModuleRestrictionO[#, 
                BrauerAlgebra`Private`dim]& ]]]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`SymplecticGroup, If[
             Or[
              Not[
               EvenQ[BrauerAlgebra`Private`dim]], 
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           If[
             Not[
              BrauerAlgebra`Private`SymmetricModuleRestrictionSp[
              BrauerAlgebra`Private`mu, BrauerAlgebra`Private`dim]], 
             BrauerAlgebra`Private`res = {}, BrauerAlgebra`Private`res = 
             Map[BrauerAlgebra`EigenvaluesA[
               BrauerAlgebra`Private`mu, #, BrauerAlgebra`Private`dim, 
                BrauerAlgebra`Private`options]& , 
               Select[
                Flatten[
                 Map[
                 SymmetricFunctions`InverseLittlewoodRichardsonRule[
                  BrauerAlgebra`Private`mu, #]& , 
                  BrauerAlgebra`Private`EvenPartitionIn[
                  BrauerAlgebra`Private`mu]], 1], 
                BrauerAlgebra`Private`BrauerModuleRestrictionSp[#, 
                 BrauerAlgebra`Private`dim]& ]]]; Null]; 
         If[BrauerAlgebra`Private`schurweyl === None, 
           BrauerAlgebra`Private`res = 
           Map[BrauerAlgebra`EigenvaluesA[
             BrauerAlgebra`Private`mu, #, BrauerAlgebra`Private`dim, 
              BrauerAlgebra`Private`options]& , 
             Flatten[
              Map[
              SymmetricFunctions`InverseLittlewoodRichardsonRule[
               BrauerAlgebra`Private`mu, #]& , 
               BrauerAlgebra`Private`EvenPartitionIn[
               BrauerAlgebra`Private`mu]], 1]]]; BrauerAlgebra`Private`res], 
       BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 
         Pattern[BrauerAlgebra`Private`dim, 
          Blank[Integer]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       Block[{BrauerAlgebra`Private`res, 
          BrauerAlgebra`Private`schurweyl}, {BrauerAlgebra`Private`schurweyl} = 
          OptionValue[{BrauerAlgebra`EigenvaluesA}, {
            BrauerAlgebra`Private`options}, {BrauerAlgebra`SchurWeylDual}]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`OrthogonalGroup, If[
             Not[
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           BrauerAlgebra`Private`res = Map[BrauerAlgebra`EigenvaluesA[
               Apply[Sequence, #], BrauerAlgebra`Private`dim]& , 
              BrauerAlgebra`Private`PairsOfPartitionsOrthogonal[
              BrauerAlgebra`Private`n, BrauerAlgebra`Private`dim]]]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`SymplecticGroup, If[
             Or[
              Not[
               EvenQ[BrauerAlgebra`Private`dim]], 
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           BrauerAlgebra`Private`res = Map[BrauerAlgebra`EigenvaluesA[
               Apply[Sequence, #], BrauerAlgebra`Private`dim]& , 
              BrauerAlgebra`Private`PairsOfPartitionsSymplectic[
              BrauerAlgebra`Private`n, BrauerAlgebra`Private`dim]]]; 
         If[BrauerAlgebra`Private`schurweyl === None, 
           BrauerAlgebra`Private`res = Map[BrauerAlgebra`EigenvaluesA[
              Apply[Sequence, #], BrauerAlgebra`Private`dim]& , 
             Flatten[
              BrauerAlgebra`Private`PairsOfPartitions[
              BrauerAlgebra`Private`n], 1]]]; BrauerAlgebra`Private`res], 
       BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`mu, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`lambda, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`EigenvaluesA[
        BrauerAlgebra`Private`mu, BrauerAlgebra`Private`lambda, 
         BrauerAlgebra`BrauerParameter[], BrauerAlgebra`Private`options], 
       BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`mu, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`EigenvaluesA[BrauerAlgebra`Private`mu, 
         BrauerAlgebra`BrauerParameter[], BrauerAlgebra`Private`options], 
       BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       BrauerAlgebra`EigenvaluesA[BrauerAlgebra`Private`n, 
         BrauerAlgebra`BrauerParameter[], BrauerAlgebra`Private`options], 
       BrauerAlgebra`EigenvaluesA[
         Pattern[BrauerAlgebra`Private`n, 
          Blank[Integer]], 
         Pattern[BrauerAlgebra`Private`lambda, 
          Blank[List]], 
         Pattern[BrauerAlgebra`Private`dim, 
          Blank[Integer]], 
         Pattern[BrauerAlgebra`Private`options, 
          OptionsPattern[]]] :> 
       Block[{BrauerAlgebra`Private`f = (BrauerAlgebra`Private`n - Apply[
            Plus, BrauerAlgebra`Private`lambda])/2, BrauerAlgebra`Private`res,
           BrauerAlgebra`Private`schurweyl}, {
           BrauerAlgebra`Private`schurweyl} = 
          OptionValue[{BrauerAlgebra`EigenvaluesA}, {
            BrauerAlgebra`Private`options}, {BrauerAlgebra`SchurWeylDual}]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`OrthogonalGroup, If[
             Not[
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           If[
             Not[
              BrauerAlgebra`Private`BrauerModuleRestrictionO[
              BrauerAlgebra`Private`lambda, BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "schurweyl1"], 
               BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`schurweyl]]]; 
           BrauerAlgebra`Private`res = 
            Map[BrauerAlgebra`EigenvaluesA[#, BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`options]& , 
              Select[
               IntegerPartitions[BrauerAlgebra`Private`n], And[
                MemberQ[
                 BrauerAlgebra`Private`PairsOfPartitions[
                 BrauerAlgebra`Private`n, BrauerAlgebra`Private`f], {#, 
                  BrauerAlgebra`Private`lambda}], 
                
                BrauerAlgebra`Private`SymmetricModuleRestrictionO[#, 
                 BrauerAlgebra`Private`dim]]& ]]]; 
         If[BrauerAlgebra`Private`schurweyl === 
           SymmetricFunctions`SymplecticGroup, If[
             Or[
              Not[
               EvenQ[BrauerAlgebra`Private`dim]], 
              Positive[BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "dimension"], 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`schurweyl]]]; 
           If[
             Not[
              BrauerAlgebra`Private`BrauerModuleRestrictionSp[
              BrauerAlgebra`Private`lambda, BrauerAlgebra`Private`dim]], 
             Throw[
              Message[
               MessageName[BrauerAlgebra`EigenvaluesA, "schurweyl1"], 
               BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`schurweyl]]]; 
           BrauerAlgebra`Private`res = 
            Map[BrauerAlgebra`EigenvaluesA[#, BrauerAlgebra`Private`lambda, 
               BrauerAlgebra`Private`dim, BrauerAlgebra`Private`options]& , 
              Select[
               IntegerPartitions[BrauerAlgebra`Private`n], And[
                MemberQ[
                 BrauerAlgebra`Private`PairsOfPartitions[
                 BrauerAlgebra`Private`n, BrauerAlgebra`Private`f], {#, 
                  BrauerAlgebra`Private`lambda}], 
                
                BrauerAlgebra`Private`SymmetricModuleRestrictionSp[#, 
                 BrauerAlgebra`Private`dim]]& ]]]; 
         If[BrauerAlgebra`Private`schurweyl === None, 
           BrauerAlgebra`Private`res = 
           Map[BrauerAlgebra`EigenvaluesA[#, BrauerAlgebra`Private`lambda, 
              BrauerAlgebra`Private`dim, BrauerAlgebra`Private`options]& , 
             IntegerPartitions[BrauerAlgebra`Private`n]]]; 
         BrauerAlgebra`Private`res]}], "SubValues" -> None, "DefaultValues" -> 
    None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {BrauerAlgebra`SchurWeylDual -> None}, 
    "Attributes" -> {Protected}, "FullName" -> "BrauerAlgebra`EigenvaluesA"|>,
