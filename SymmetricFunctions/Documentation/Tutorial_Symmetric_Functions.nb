   "ObjectType" -> "Symbol", "Usage" -> 
    "LittlewoodRichardsonRule[\[Mu],\[Lambda]] returns a list of the \
partitions (with multiplicities)\n corresponding to irreducible \
representations of GL appearing in the tensor product of the irreducible \
representations \[Mu] and \[Lambda].\!\(\*ButtonBox[StyleBox[\"[Fulton \
1996]\", \"SR\"],Active->True,BaseStyle->\"Link\",ButtonData->\"http://dx.doi.\
org/10.1017/CBO9780511626241\"]\)", "Documentation" -> None, "OwnValues" -> 
    None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, SymmetricFunctions`LittlewoodRichardsonRule, {
      SymmetricFunctions`LittlewoodRichardsonRule[{}, 
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[]]] :> {SymmetricFunctions`Private`\[Lambda]}, 
       SymmetricFunctions`LittlewoodRichardsonRule[
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[]], {}] :> {SymmetricFunctions`Private`\[Lambda]}, Condition[
         SymmetricFunctions`LittlewoodRichardsonRule[
          Pattern[SymmetricFunctions`Private`list1, 
           Blank[]], 
          Pattern[SymmetricFunctions`Private`list2, 
           Blank[]]], 
         Or[
         Part[SymmetricFunctions`Private`list1, 1] == 1, 
          Length[SymmetricFunctions`Private`list1] == 1]] :> 
       SymmetricFunctions`Private`PieriRule[
        SymmetricFunctions`Private`list1, SymmetricFunctions`Private`list2], 
       Condition[
         SymmetricFunctions`LittlewoodRichardsonRule[
          Pattern[SymmetricFunctions`Private`list1, 
           Blank[]], 
          Pattern[SymmetricFunctions`Private`list2, 
           Blank[]]], 
         Or[
         Part[SymmetricFunctions`Private`list2, 1] == 1, 
          Length[SymmetricFunctions`Private`list2] == 1]] :> 
       SymmetricFunctions`Private`PieriRule[
        SymmetricFunctions`Private`list2, SymmetricFunctions`Private`list1], 
       SymmetricFunctions`LittlewoodRichardsonRule[
         Pattern[SymmetricFunctions`Private`p, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`q, 
          Blank[]]] :> 
       Block[{SymmetricFunctions`Private`\[Lambda] = 
          DeleteCases[SymmetricFunctions`Private`p, 0], 
          SymmetricFunctions`Private`\[Nu] = 
          DeleteCases[SymmetricFunctions`Private`q, 0], 
          SymmetricFunctions`Private`res}, 
         If[
         Length[SymmetricFunctions`Private`\[Lambda]] >= 
          Length[SymmetricFunctions`Private`\[Nu]], 
          SymmetricFunctions`Private`res = Map[Length, 
             SymmetricFunctions`Private`LRTableaux[
             SymmetricFunctions`Private`\[Lambda], 
              SymmetricFunctions`Private`\[Nu], 
              Length[SymmetricFunctions`Private`\[Nu]]], {2}]; 
          DownValues[SymmetricFunctions`Private`LatticeWordQ] = Take[
             DownValues[SymmetricFunctions`Private`LatticeWordQ], -2]; 
          Return[SymmetricFunctions`Private`res, Block], 
          SymmetricFunctions`Private`res = Map[Length, 
             SymmetricFunctions`Private`LRTableaux[
             SymmetricFunctions`Private`\[Nu], 
              SymmetricFunctions`Private`\[Lambda], 
              Length[SymmetricFunctions`Private`\[Lambda]]], {2}]; 
          DownValues[SymmetricFunctions`Private`LatticeWordQ] = Take[
             DownValues[SymmetricFunctions`Private`LatticeWordQ], -2]; 
          Return[SymmetricFunctions`Private`res, Block]]], 
       SymmetricFunctions`LittlewoodRichardsonRule[
         Pattern[SymmetricFunctions`Private`list1, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`list2, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`list3, 
          BlankSequence[]]] :> Sort[
         Fold[SymmetricFunctions`Private`LittlewoodRichardsonRuleMap, 
          SymmetricFunctions`LittlewoodRichardsonRule[
          SymmetricFunctions`Private`list1, 
           SymmetricFunctions`Private`list2], {
          SymmetricFunctions`Private`list3}]]}], "SubValues" -> None, 
