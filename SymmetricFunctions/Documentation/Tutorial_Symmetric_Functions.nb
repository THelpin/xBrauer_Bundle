  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "SemiStandardTableaux[{\[Lambda],\[Mu]},\[Rho]] returns a list of all \
SSYT with the skew shape \[Lambda]/\[Mu] and weight \[Rho].\n\
SemiStandardTableaux[\[Lambda],\[Rho]] returns a list of all SSYT with shape \
\[Lambda] and weight \[Rho].", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, SymmetricFunctions`SemiStandardTableaux, {
      SymmetricFunctions`SemiStandardTableaux[{
          Pattern[SymmetricFunctions`Private`\[Lambda], 
           Blank[List]], 
          Pattern[SymmetricFunctions`Private`\[Mu], 
           Blank[List]]}, 
         Pattern[SymmetricFunctions`Private`max, 
          Blank[Integer]]] :> 
       With[{SymmetricFunctions`Private`weights = 
          IntegerPartitions[
           Tr[SymmetricFunctions`Private`\[Lambda]] - Tr[
            SymmetricFunctions`Private`\[Mu]], 
            SymmetricFunctions`Private`max]}, 
         Apply[Join, 
          Table[
           
           SymmetricFunctions`SemiStandardTableaux[{
            SymmetricFunctions`Private`\[Lambda], 
             SymmetricFunctions`Private`\[Mu]}, 
            SymmetricFunctions`Private`w], {
           SymmetricFunctions`Private`w, 
            SymmetricFunctions`Private`weights}]]], 
       SymmetricFunctions`SemiStandardTableaux[{
          Pattern[SymmetricFunctions`Private`\[Lambda], 
           Blank[List]], 
          Pattern[SymmetricFunctions`Private`\[Mu], 
           Blank[List]]}] :> 
       SymmetricFunctions`SemiStandardTableaux[{
         SymmetricFunctions`Private`\[Lambda], 
          SymmetricFunctions`Private`\[Mu]}, 
         Tr[SymmetricFunctions`Private`\[Lambda]] - Tr[
         SymmetricFunctions`Private`\[Mu]]], Condition[
         SymmetricFunctions`SemiStandardTableaux[{
           Pattern[SymmetricFunctions`Private`\[Lambda], 
            Blank[List]], 
           Pattern[SymmetricFunctions`Private`muIn, 
            Blank[List]]}, 
          Pattern[SymmetricFunctions`Private`w, 
           Blank[List]]], 
         Tr[SymmetricFunctions`Private`\[Lambda]] - Tr[
          SymmetricFunctions`Private`muIn] - Tr[SymmetricFunctions`Private`w] != 
         0] :> {}, SymmetricFunctions`SemiStandardTableaux[{
          Pattern[SymmetricFunctions`Private`lambdaIn, 
           Blank[List]], 
          Pattern[SymmetricFunctions`Private`muIn, 
           Blank[List]]}, 
         Pattern[SymmetricFunctions`Private`w, 
          Blank[List]]] :> 
       Module[{
         SymmetricFunctions`Private`isEdgeQ, 
          SymmetricFunctions`Private`partitionLevels, 
          SymmetricFunctions`Private`directedEdges, 
          SymmetricFunctions`Private`mid, SymmetricFunctions`Private`lam = 
          SymmetricFunctions`Private`lambdaIn, SymmetricFunctions`Private`mu, 
          SymmetricFunctions`Private`wAcc = 
          Accumulate[SymmetricFunctions`Private`w], 
          SymmetricFunctions`Private`ssytPaths, SymmetricFunctions`Private`q, 
          SymmetricFunctions`Private`graph}, 
         SymmetricFunctions`Private`mu = 
          PadRight[SymmetricFunctions`Private`muIn, 
            Length[SymmetricFunctions`Private`lam]]; 
         SymmetricFunctions`Private`mid = Table[
            IntegerPartitions[
            Tr[SymmetricFunctions`Private`mu] + 
             SymmetricFunctions`Private`wi, {
              Length[SymmetricFunctions`Private`lam]}, 
             Range[0, 
              Max[SymmetricFunctions`Private`lam]]], {
            SymmetricFunctions`Private`wi, 
             Most[SymmetricFunctions`Private`wAcc]}]; 
         SymmetricFunctions`Private`partitionLevels = 
          Join[{{SymmetricFunctions`Private`mu}}, 
            SymmetricFunctions`Private`mid, {{
             SymmetricFunctions`Private`lam}}]; 
         SymmetricFunctions`Private`isEdgeQ[
            Pattern[SymmetricFunctions`Private`p, 
             Blank[List]], 
            Pattern[SymmetricFunctions`Private`q, 
             Blank[List]]] := And[
            And[
            Min[SymmetricFunctions`Private`p - SymmetricFunctions`Private`q] >= 
             0, Min[Part[SymmetricFunctions`Private`q, 
                 Span[1, -2]] - Part[SymmetricFunctions`Private`p, 
                Span[2, All]]] >= 0]]; 
         SymmetricFunctions`Private`directedEdges = Apply[Join, 
            Table[
             Apply[Join, 
              Outer[If[
                SymmetricFunctions`Private`isEdgeQ[#2, #], 
                
                DirectedEdge[{#, SymmetricFunctions`Private`lvl - 1}, {#2, 
                  SymmetricFunctions`Private`lvl}], Nothing]& , 
               Part[
               SymmetricFunctions`Private`partitionLevels, 
                SymmetricFunctions`Private`lvl - 1], 
               Part[
               SymmetricFunctions`Private`partitionLevels, 
                SymmetricFunctions`Private`lvl], 1]], {
             SymmetricFunctions`Private`lvl, 2, 
              Length[SymmetricFunctions`Private`partitionLevels]}]]; 
         SymmetricFunctions`Private`graph = 
          Graph[SymmetricFunctions`Private`directedEdges]; 
         SymmetricFunctions`Private`ssytPaths = If[
            Or[
             Not[
              MemberQ[
               VertexList[SymmetricFunctions`Private`graph], {
               SymmetricFunctions`Private`mu, 1}]], 
             Not[
              MemberQ[
               VertexList[SymmetricFunctions`Private`graph], {
               SymmetricFunctions`Private`lam, 
                Length[SymmetricFunctions`Private`w] + 1}]]], {}, 
            FindPath[
            SymmetricFunctions`Private`graph, {
             SymmetricFunctions`Private`mu, 1}, {
             SymmetricFunctions`Private`lam, 
              Length[SymmetricFunctions`Private`w] + 1}, Infinity, All]]; 
         Map[SymmetricFunctions`Private`pathToSSYT[
            Map[First, #]]& , SymmetricFunctions`Private`ssytPaths]], 
       Condition[
         SymmetricFunctions`SemiStandardTableaux[
          Pattern[SymmetricFunctions`Private`\[Lambda], 
           Blank[List]], 
          Pattern[SymmetricFunctions`Private`\[Rho], 
           Blank[List]]], 
         Not[
          SymmetricFunctions`PartitionDominatesQ[
          SymmetricFunctions`Private`\[Lambda], 
           SymmetricFunctions`Private`\[Rho]]]] :> {}, 
       SymmetricFunctions`SemiStandardTableaux[
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[List]], 
         Pattern[SymmetricFunctions`Private`\[Rho], 
          Blank[List]]] :> 
       SymmetricFunctions`SemiStandardTableaux[{
         SymmetricFunctions`Private`\[Lambda], {}}, 
         SymmetricFunctions`Private`\[Rho]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {Protected}, "FullName" -> 
    "SymmetricFunctions`SemiStandardTableaux"|>, False]]], "Output",
 CellChangeTimes->{3.891056330678076*^9, 3.8910725963543367`*^9, 
  3.8910732547140102`*^9, 3.89107541578907*^9, 3.975642633875046*^9},
