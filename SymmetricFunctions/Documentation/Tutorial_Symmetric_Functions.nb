           Return[0]]; If[
           Or[
           SymmetricFunctions`Private`n\[Nu] + 
             SymmetricFunctions`Private`n\[Mu] < 
            SymmetricFunctions`Private`n\[Lambda], 
            SymmetricFunctions`Private`n\[Lambda] + 
             SymmetricFunctions`Private`n\[Mu] < 
            SymmetricFunctions`Private`n\[Nu], 
            SymmetricFunctions`Private`n\[Lambda] + 
             SymmetricFunctions`Private`n\[Nu] < 
            SymmetricFunctions`Private`n\[Mu]], 
           Return[0]]; 
         If[SymmetricFunctions`Private`n\[Mu] + 
            SymmetricFunctions`Private`n\[Nu] == 
           SymmetricFunctions`Private`n\[Lambda], 
           Return[
            SymmetricFunctions`LittlewoodRichardsonCoefficient[
            SymmetricFunctions`Private`\[Lambda], 
             SymmetricFunctions`Private`\[Mu], 
             SymmetricFunctions`Private`\[Nu]]], 
           If[
           SymmetricFunctions`Private`n\[Mu] + 
             SymmetricFunctions`Private`n\[Lambda] == 
            SymmetricFunctions`Private`n\[Nu], 
            Return[
             SymmetricFunctions`LittlewoodRichardsonCoefficient[
             SymmetricFunctions`Private`\[Nu], 
              SymmetricFunctions`Private`\[Lambda], 
              SymmetricFunctions`Private`\[Mu]]], 
            If[
            SymmetricFunctions`Private`n\[Nu] + 
              SymmetricFunctions`Private`n\[Lambda] == 
             SymmetricFunctions`Private`n\[Mu], 
             Return[
              SymmetricFunctions`LittlewoodRichardsonCoefficient[
              SymmetricFunctions`Private`\[Mu], 
               SymmetricFunctions`Private`\[Nu], 
               SymmetricFunctions`Private`\[Lambda]]]]]]; 
         Module[{SymmetricFunctions`Private`\[Tau]s = Flatten[
              Map[IntegerPartitions[#]& , 
               Range[0, 
                Max[
                SymmetricFunctions`Private`n\[Mu], 
                 SymmetricFunctions`Private`n\[Nu]]]], 1], 
            SymmetricFunctions`Private`\[Xi]s = Flatten[
              Map[IntegerPartitions[#]& , 
               Range[0, 
                Max[
                SymmetricFunctions`Private`n\[Lambda], 
                 SymmetricFunctions`Private`n\[Mu]]]], 1], 
            SymmetricFunctions`Private`\[Eta]s = Flatten[
              Map[IntegerPartitions[#]& , 
               Range[0, 
                Max[
                SymmetricFunctions`Private`n\[Nu], 
                 SymmetricFunctions`Private`n\[Lambda]]]], 1], 
            SymmetricFunctions`Private`temp = {}}, Do[
             If[
              And[Tr[
                  Part[
                  SymmetricFunctions`Private`\[Tau]s, 
                   SymmetricFunctions`Private`k]] + Tr[
                  Part[
                  SymmetricFunctions`Private`\[Xi]s, 
                   SymmetricFunctions`Private`j]] == 
               SymmetricFunctions`Private`n\[Mu], Tr[
                  Part[
                  SymmetricFunctions`Private`\[Tau]s, 
                   SymmetricFunctions`Private`k]] + Tr[
                  Part[
                  SymmetricFunctions`Private`\[Eta]s, 
                   SymmetricFunctions`Private`i]] == 
               SymmetricFunctions`Private`n\[Nu], Tr[
                  Part[
                  SymmetricFunctions`Private`\[Xi]s, 
                   SymmetricFunctions`Private`j]] + Tr[
                  Part[
                  SymmetricFunctions`Private`\[Eta]s, 
                   SymmetricFunctions`Private`i]] == 
               SymmetricFunctions`Private`n\[Lambda]], 
              AppendTo[
              SymmetricFunctions`Private`temp, 
               SymmetricFunctions`LittlewoodRichardsonCoefficient[
                SymmetricFunctions`Private`\[Mu], 
                 Part[
                 SymmetricFunctions`Private`\[Tau]s, 
                  SymmetricFunctions`Private`k], 
                 Part[
                 SymmetricFunctions`Private`\[Xi]s, 
                  SymmetricFunctions`Private`j]] 
               SymmetricFunctions`LittlewoodRichardsonCoefficient[
                SymmetricFunctions`Private`\[Nu], 
                 Part[
                 SymmetricFunctions`Private`\[Tau]s, 
                  SymmetricFunctions`Private`k], 
                 Part[
                 SymmetricFunctions`Private`\[Eta]s, 
                  SymmetricFunctions`Private`i]] 
               SymmetricFunctions`LittlewoodRichardsonCoefficient[
                SymmetricFunctions`Private`\[Lambda], 
                 Part[
                 SymmetricFunctions`Private`\[Xi]s, 
                  SymmetricFunctions`Private`j], 
                 Part[
                 SymmetricFunctions`Private`\[Eta]s, 
                  SymmetricFunctions`Private`i]]]], {
             SymmetricFunctions`Private`i, 1, 
              Length[SymmetricFunctions`Private`\[Eta]s]}, {
             SymmetricFunctions`Private`j, 1, 
              Length[SymmetricFunctions`Private`\[Xi]s]}, {
             SymmetricFunctions`Private`k, 1, 
              Length[SymmetricFunctions`Private`\[Tau]s]}]; 
           Apply[Plus, SymmetricFunctions`Private`temp]]]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {Protected}, "FullName" -> 
    "SymmetricFunctions`NewellLittlewoodCoefficient"|>, False]]], "Output",
 CellChangeTimes->{3.891054205018014*^9, 3.891054414380128*^9, 
