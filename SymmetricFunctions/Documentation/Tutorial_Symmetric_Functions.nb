  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "LittlewoodRichardsonCoefficient[\[Mu],\[Nu],\[Lambda]] returns the \
Littlewood-Richardson coefficient \!\(\*SubscriptBox[SuperscriptBox[\(C\), \(\
\[Mu]\)], \(\[Nu]\[Lambda]\)]\) : \
\[Nu]\[TensorProduct]\[Lambda]=\!\(\*SubscriptBox[SuperscriptBox[\(\
\[CapitalSigma]C\), \(\[Mu]\)], \(\[Nu]\[Lambda]\)]\) \[Mu], where \[Nu],\
\[Lambda] and \[Mu] \nare irreducible representations of GL. These are also \
the coefficient in the product expandsion of Schur functions \
\!\(\*SubscriptBox[\(s\), \(\[Nu]\)]\)\!\(\*SubscriptBox[\(s\), \
\(\[Lambda]\)]\)=\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalSigma]C\), \(\
\[Mu]\)], \(\[Nu]\[Lambda]\)]\) \!\(\*SubscriptBox[\(s\), \(\[Mu]\)]\). \n\
LittlewoodRichardsonCoefficient[\[Mu],\[Nu]] enumerates the partitions \
\[Lambda] with its non vanishing LittlewoodRichardsonCoefficient \
\!\(\*SubscriptBox[SuperscriptBox[\(C\), \(\[Mu]\)], \(\[Nu]\[Lambda]\)]\).\n\
LittlewoodRichardsonCoefficient[\[Mu]] enumerates the pairs of partitions (\
\[Lambda],\[Nu]) with its non vanishing LittlewoodRichardsonCoefficient \
\!\(\*SubscriptBox[SuperscriptBox[\(C\), \(\[Mu]\)], \(\[Nu]\[Lambda]\)]\).", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, SymmetricFunctions`LittlewoodRichardsonCoefficient, {
      Condition[
         SymmetricFunctions`LittlewoodRichardsonCoefficient[
          Pattern[SymmetricFunctions`Private`\[Mu], 
           Blank[]], 
          Pattern[SymmetricFunctions`Private`\[Lambda], 
           Blank[]]], 
         Not[
          SymmetricFunctions`IncludedPartitionQ[
          SymmetricFunctions`Private`\[Mu], 
           SymmetricFunctions`Private`\[Lambda]]]] :> {}, 
       SymmetricFunctions`LittlewoodRichardsonCoefficient[
         Pattern[SymmetricFunctions`Private`\[Mu], 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[]]] :> <|
         ReplaceAll[
          Tally[
           Map[SymmetricFunctions`Private`WordToWeight, 
            SymmetricFunctions`Private`LRTableauWords[
            SymmetricFunctions`Private`\[Mu], 
             SymmetricFunctions`Private`\[Lambda]]]], {{
             Pattern[SymmetricFunctions`Private`a, 
              Blank[]], 
             Pattern[SymmetricFunctions`Private`b, 
              Blank[Integer]]} :> (SymmetricFunctions`Private`a -> 
            SymmetricFunctions`Private`b)}]|>, 
       SymmetricFunctions`LittlewoodRichardsonCoefficient[
         Pattern[SymmetricFunctions`Private`\[Mu], 
          Blank[]]] :> <|
         ReplaceAll[
          Tally[
           Map[{
             SymmetricFunctions`Private`SkewedShape[#], 
             SymmetricFunctions`Private`WordToWeight[
              Values[
               Select[#, # != 0& ]]]}& , 
            SymmetricFunctions`LittlewoodRichardsonTableaux[
            SymmetricFunctions`Private`\[Mu]]]], {{
             Pattern[SymmetricFunctions`Private`a, 
              Blank[]], 
             Pattern[SymmetricFunctions`Private`b, 
              Blank[Integer]]} :> (SymmetricFunctions`Private`a -> 
            SymmetricFunctions`Private`b)}]|>, 
       SymmetricFunctions`LittlewoodRichardsonCoefficient[
         Pattern[SymmetricFunctions`Private`\[Mu], 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Nu], 
          Blank[]]] :> If[
         And[
          SymmetricFunctions`IncludedPartitionQ[
          SymmetricFunctions`Private`\[Mu], 
           SymmetricFunctions`Private`\[Lambda]], 
          SymmetricFunctions`IncludedPartitionQ[
          SymmetricFunctions`Private`\[Mu], 
           SymmetricFunctions`Private`\[Nu]]], 
         If[
         Tr[SymmetricFunctions`Private`\[Lambda]] > 
          Tr[SymmetricFunctions`Private`\[Nu]], 
          Length[
           SymmetricFunctions`Private`LRTableauWords[
           SymmetricFunctions`Private`\[Mu], 
            SymmetricFunctions`Private`\[Lambda], 
            SymmetricFunctions`Private`\[Nu]]], 
          Length[
           SymmetricFunctions`Private`LRTableauWords[
           SymmetricFunctions`Private`\[Mu], SymmetricFunctions`Private`\[Nu],
             SymmetricFunctions`Private`\[Lambda]]]], 0], 
       SymmetricFunctions`LittlewoodRichardsonCoefficient[
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]1, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]2, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]3, 
          Blank[]]] :> 
       With[{SymmetricFunctions`Private`n\[Mu]1 = 
          Tr[SymmetricFunctions`Private`\[Mu]1], 
          SymmetricFunctions`Private`n\[Mu]2 = 
          Tr[SymmetricFunctions`Private`\[Mu]2]}, 
         Apply[Plus, 
          Map[
          SymmetricFunctions`LittlewoodRichardsonCoefficient[#, 
             SymmetricFunctions`Private`\[Mu]1, 
             SymmetricFunctions`Private`\[Mu]2] 
           SymmetricFunctions`LittlewoodRichardsonCoefficient[
            SymmetricFunctions`Private`\[Lambda], #, 
             SymmetricFunctions`Private`\[Mu]3]& , 
           IntegerPartitions[
           SymmetricFunctions`Private`n\[Mu]1 + 
            SymmetricFunctions`Private`n\[Mu]2]]]], 
       SymmetricFunctions`LittlewoodRichardsonCoefficient[
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]1, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]2, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]3, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]4, 
          Blank[]]] :> 
       With[{SymmetricFunctions`Private`n\[Lambda] = 
          Tr[SymmetricFunctions`Private`\[Lambda]], 
          SymmetricFunctions`Private`n\[Mu]1 = 
          Tr[SymmetricFunctions`Private`\[Mu]1], 
          SymmetricFunctions`Private`n\[Mu]2 = 
          Tr[SymmetricFunctions`Private`\[Mu]2], 
          SymmetricFunctions`Private`n\[Mu]3 = 
          Tr[SymmetricFunctions`Private`\[Mu]3]}, 
         Apply[Plus, 
          Map[
          SymmetricFunctions`LittlewoodRichardsonCoefficient[#, 
             SymmetricFunctions`Private`\[Mu]1, 
             SymmetricFunctions`Private`\[Mu]2, 
             SymmetricFunctions`Private`\[Mu]3] 
           SymmetricFunctions`LittlewoodRichardsonCoefficient[
            SymmetricFunctions`Private`\[Lambda], #, 
             SymmetricFunctions`Private`\[Mu]4]& , 
           IntegerPartitions[
           SymmetricFunctions`Private`n\[Mu]1 + 
            SymmetricFunctions`Private`n\[Mu]2 + 
            SymmetricFunctions`Private`n\[Mu]3]]]], 
       SymmetricFunctions`LittlewoodRichardsonCoefficient[
         Pattern[SymmetricFunctions`Private`\[Lambda], 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]1, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]2, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]3, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]4, 
          Blank[]], 
         Pattern[SymmetricFunctions`Private`\[Mu]s, 
          BlankSequence[]]] :> Count[
         SymmetricFunctions`LittlewoodRichardsonRule[
         SymmetricFunctions`Private`\[Mu]1, SymmetricFunctions`Private`\[Mu]2,
           SymmetricFunctions`Private`\[Mu]3, 
          SymmetricFunctions`Private`\[Mu]4, 
          SymmetricFunctions`Private`\[Mu]s], 
         SymmetricFunctions`Private`\[Lambda]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {Protected}, "FullName" -> 
    "SymmetricFunctions`LittlewoodRichardsonCoefficient"|>, False]]], "Output",\

